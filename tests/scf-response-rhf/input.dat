for scf_type in ['pk', 'df', 'cd']:
    set_options({'scf_type': scf_type})

    properties('scf', properties=['DIPOLE_POLARIZABILITIES'])
    for label, value in ref_vals[scf_type]['POLARIZABILITY'].items():  #TEST
        compare_values(value, variable(label), 1e-08, f'{scf_type} {label}')  #TEST

    for prop, name in [('SHG', 'SCF_SHG'), ('OR', 'SCF_OPTICAL_RECTIFICATION'), ('POCKELS', 'SCF_POCKELS')]:
        properties('scf', properties=[name])
        for label, value in ref_vals[scf_type][prop].items():  #TEST
            compare_values(value, variable(label), 1e-08, f'{scf_type} {prop} {label}')  #TEST
