    },  #TEST
}  #TEST

w = 0.1
for scf_type in ['pk', 'df', 'cd']:
    set_options({'scf_type': scf_type})

    # static alpha: built-in solver (OMEGA unset) and this module (OMEGA [0.0])
    core.revoke_global_option_changed('OMEGA')
    properties('scf', properties=['DIPOLE_POLARIZABILITIES'])
    builtin = np.array([[variable(f'DIPOLE POLARIZABILITY {p}{q}') for q in XYZ] for p in XYZ])
    set_options({'omega': [0.0]})
    properties('scf', properties=['DIPOLE_POLARIZABILITIES'])
    compare_arrays(builtin, alpha_tensor(0.0), 1.e-8, f'{scf_type}: static alpha vs built-in solver')  #TEST
    compare_arrays(ref[scf_type]['alpha_static'], alpha_tensor(0.0), 1.e-6, f'{scf_type}: static alpha vs reference')  #TEST

    properties('scf', properties=['SCF_DIPOLE_HYPERPOLARIZABILITY'])
    compare_arrays(ref[scf_type]['STATIC'], beta_tensor('STATIC'), 1.e-5, f'{scf_type}: static beta vs reference')  #TEST

    set_options({'omega': [w]})
    properties('scf', properties=['DIPOLE_POLARIZABILITIES', 'SCF_SHG', 'SCF_OPTICAL_RECTIFICATION', 'SCF_POCKELS'])
    compare_arrays(ref[scf_type]['alpha'], alpha_tensor(w), 1.e-6, f'{scf_type}: alpha({w}) vs reference')  #TEST
    for kind in ['SHG', 'OR', 'POCKELS']:
        compare_arrays(ref[scf_type][kind], beta_tensor(kind, w), 1.e-5, f'{scf_type}: {kind} beta({w}) vs reference')  #TEST
    shg = beta_tensor('SHG', w)
    compare_arrays(shg, shg.transpose(0, 2, 1), 1.e-10, f'{scf_type}: SHG beta symmetric in last two indices')  #TEST
    compare_arrays(beta_tensor('OR', w), beta_tensor('POCKELS', w).transpose(2, 0, 1), 1.e-10, f'{scf_type}: OR / Pockels index relation')  #TEST
