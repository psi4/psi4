#! RHF/cc-pVDZ water at omega = 0.15 au: dipole polarizability and SHG, optical rectification, and Pockels first hyperpolarizabilities
#! for SCF_TYPE PK, DF, and CD. Ported from the scf_response plugin's own tests
#! (edeprince3/scf_response, tests/rhf_{pk,df,cd}.in); reference values are the plugin's.

molecule {
O  0.00000   0.00000   0.11572
H  0.00000   0.74879  -0.46288
H  0.00000  -0.74879  -0.46288
nocom
no_reorient
symmetry c1
}

set {
  basis cc-pvdz
  reference rhf
  e_convergence 1e-10
  d_convergence 1e-10
  solver_convergence 1e-10
  cholesky_tolerance 1e-12
  omega [0.15]
}

