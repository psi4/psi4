#! RHF stability FOLLOW test for a stable system (water, cc-pVDZ).
#! Verifies that FOLLOW does not attempt to rotate orbitals when the wavefunction is already a singlet-stable minimum.
#! The wfn's ``attempt_number_`` must remain 1 (no re-SCF triggered) and the post-FOLLOW energy must match the RHF
#! reference.

nucenergy =   8.8014655646     #TEST
refenergy = -76.02141844515491 #TEST

molecule h2o {
0 1
O
H 1 1.0
H 1 1.0 2 104.5
}

set {
basis cc-pvdz
reference rhf
scf_type pk
d_convergence 8
stability_analysis follow
}

thisenergy, wfn = energy('scf', return_wfn=True)

# If FOLLOW returned True, scf_iterator.py would increment the attempt counter to 2+.
# A value of 1 proves FOLLOW returned False, meaning no orbital rotation, no re-SCF.
attempts = wfn.attempt_number_

compare_values(nucenergy, h2o.nuclear_repulsion_energy(), 9, "Nuclear repulsion energy") #TEST
compare_values(refenergy, thisenergy, 7, "Reference energy")                             #TEST
compare_integers(1, attempts, "Stable RHF FOLLOW did not rotate orbitals")               #TEST
