#! CGHF test for running CO without DIIS -- assert SCF does NOT converge

reference_e = -112.6661373

molecule co {
0 1
  C
  O 1 1.11
symmetry C1
}

set = {
    basis                   6-31g
    reference               cghf
    guess                   sad
    scf_type                direct
    df_scf_guess            false
    diis                    false
    scf_initial_accelerator none
    maxiter                 14
    e_convergence           5e-7
    orbital_optimizer_package internal
}

# Interestingly, M-Intel forces OOO which doesn't respect diis or
# scf_initial_accelerator options. I have to explicitly change
# orbital_optimizer_package because the default gets changed in the CI.

try:
    energy('scf')
    converged = True
except SCFConvergenceError:
    converged = False

compare(True, not converged, "SCF should NOT converge without DIIS") #TEST

set = {
    diis true
}

calculated_e = energy('scf')

compare_values(reference_e, calculated_e, 6, "Converged total E")    #TEST
