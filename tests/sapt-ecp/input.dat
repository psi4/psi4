#! sapt0 of charged system in ECP basis set

molecule {
0 1
H -0.803001 1.098737 0.000360
H -0.919454 -1.089722 0.000521
O -0.035537 -0.067631 0.000218
--
2 1
Ca 2.281447 -0.004247 -0.000154
units angstrom
no_reorient
symmetry c1
}

set globals {
scf_type df
freeze_core true
e_convergence 10
d_convergence 10
diis_rms_error false
df_fitting_condition 1.e-12
df_basis_sapt def2-qzvpp-ri  # not a recommendation. present to compensate for change in default
}

ref_321g = -0.09561567760757009
ref_lanl = -0.1039198330806006  # libecpint >=1.1 (stock 1.0.7 gave -0.1039198611537151; v1.1 HF dimer matches NWChem to 2e-9, stock 3e-8 off)

E = energy('sapt0/3-21g')
compare_values(ref_321g, E, 8, "SAPT0 energy with Ca2+, without ECP")                               #TEST
E = energy('sapt0/lanl2dz')
compare_values(ref_lanl, E, 8, "SAPT0 energy with Ca2+, with ECP")                                  #TEST
elst_sapt0 = variable("SAPT ELST ENERGY")

# SAPT(DFT) w/ HF functional and SF-SAPT share SAPT0's Elst10,r (agree to ~1e-8 here). Their intermonomer nuclear
#   repulsion once came from molecules that hadn't built the basis (full Z on monomer B's Ca), giving Elst +21.3 Eh
#   pre-fix: SAPT(DFT) Elst 21.3474515665, SF-SAPT Elst 21.3474515664; SAPT0 Elst -0.0980459593 (all Eh)
set sapt_dft_functional hf
set sapt_dft_grac_shift_a 0.0
set sapt_dft_grac_shift_b 0.0
set sapt_dft_do_dhf false
energy('sapt(dft)/lanl2dz')
compare_values(elst_sapt0, variable("SAPT ELST ENERGY"), 6, "SAPT(DFT) Elst with ECP on monomer B v. SAPT0")  #TEST

set reference rohf
energy('sf-sapt/lanl2dz')
compare_values(elst_sapt0, variable("SAPT ELST ENERGY"), 6, "SF-SAPT Elst with ECP on monomer B v. SAPT0")    #TEST


