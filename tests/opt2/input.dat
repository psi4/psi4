#! SCF DZ allene geometry optimization, with Cartesian input, first in c2v symmetry,
#! then in Cs symmetry from a starting point with a non-linear central bond angle.

oopkg  = "ooo" if os.environ.get("_PSI4_USE_OOPKG") else "internal"
soopkg = "otr" if os.environ.get("_PSI4_USE_OTRPKG") else "internal"
soscf  = bool(os.environ.get("_PSI4_USE_SOSCF") or os.environ.get("_PSI4_USE_OTRPKG"))
psi4.set_options({"orbital_optimizer_package": oopkg,
                  "second_order_orbital_optimizer_package": soopkg,
                  "soscf": soscf})
compare(oopkg.upper(), psi4.core.get_global_option("ORBITAL_OPTIMIZER_PACKAGE"), f"{oopkg=}")  #TEST
compare(soopkg.upper(), psi4.core.get_global_option("SECOND_ORDER_ORBITAL_OPTIMIZER_PACKAGE"), f"{soopkg=}")  #TEST

nucenergy =   59.2532646680161                                                                 #TEST
refenergy = -115.8302823663                                                                    #TEST

# starting point is D2d/c2v
molecule allene {
 H  0.0  -0.92   -1.8
 H  0.0   0.92   -1.8
 C  0.0   0.00   -1.3
 C  0.0   0.00    0.0
 C  0.0   0.00    1.3
 H  0.92  0.00    1.8
 H -0.92  0.00    1.8
}

set {
  basis DZ
  e_convergence 10
  d_convergence 10
  scf_type pk
}

thisenergy, wfn = optimize('scf', return_wfn=True)

_eff = {"internal": "internal", "ooo": "openorbitaloptimizer", "otr": "opentrustregion"}      #TEST
# The keyword compares above prove the request landed; these prove it survived the           #TEST
# compatibility guards, so a silent fallback to the internal optimizer fails the test.       #TEST
compare(_eff[oopkg], wfn.module_role("orbital_optimizer"), "effective 1st-order module")     #TEST
compare(_eff[soopkg] if soscf else "", wfn.module_role("second_order_orbital_optimizer"),
        "effective 2nd-order module")                                                        #TEST

compare_values(nucenergy, allene.nuclear_repulsion_energy(), 2, "Nuclear repulsion energy")    #TEST
compare_values(refenergy, thisenergy, 6, "Reference energy")                                   #TEST

# central C-C-C bond angle starts around 170 degrees to test the dynamic addition
# of new linear bending coordinates, and the redefinition of dihedrals.
molecule allene {
 H  0.0  -0.92   -1.8
 H  0.0   0.92   -1.8
 C  0.0   0.00   -1.3
 C  0.0   0.10    0.0
 C  0.0   0.00    1.3
 H  0.92  0.00    1.8
 H -0.92  0.00    1.8
}

thisenergy = optimize('scf')

compare_values(nucenergy, allene.nuclear_repulsion_energy(), 2, "Nuclear repulsion energy")    #TEST
compare_values(refenergy, thisenergy, 6, "Reference energy")                                   #TEST
compare(True, int(variable("OPTIMIZATION ITERATIONS")) < 9, f"Opt iter={int(variable('OPTIMIZATION ITERATIONS'))}")  #TEST
