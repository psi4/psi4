#! Kr--Kr no-counterpoise DF-MP2 interaction energies with an all-electron basis set to check frozen core

molecule kr2 {
0 1
Kr 0 0 0
--
0 1
Kr 3 0 0 
no_reorient
no_com
}

set globals {
scf_type df
mp2_type df
e_convergence 1.0e-10
d_convergence 1.0e-10
}

ref_0 = 0.012274322894882062                                                       #TEST
ref_1 = 0.012873836410108197                                                       #TEST
ref_2 = 0.012305539379667607                                                       #TEST
ref_3 = 0.012274501504180080                                                       #TEST

if psi4.core.get_option("scf", "orbital_optimizer_package") != "INTERNAL":  # KP-TOL
    tol = 8
else:
    tol = 2.e-8

# Each monomer in its own basis and in the dimer frame (no_com, no_reorient)
kr_a = kr2.extract_subsets(1)
kr_b = kr2.extract_subsets(2)

# NoCP interaction energy E(Kr2) - E(Kr_a) - E(Kr_b), computed explicitly rather than through
#   energy(..., bsse_type="nocp") so that this frozen-core test does not need QCManyBody.
#   Also returns the number of frozen orbitals in the dimer and in each monomer.
def nocp_ie():
    ie = 0.0
    nfrzc = []
    for mol, coef in [(kr2, 1.0), (kr_a, -1.0), (kr_b, -1.0)]:
        e, wfn = energy('mp2/def2-svp', molecule=mol, return_wfn=True)
        ie += coef * e
        nfrzc.append(wfn.nfrzc())
        clean()
    return ie, nfrzc

set freeze_core 0
E, nfrzc = nocp_ie()
compare_values(ref_0, E, tol, "Kr--Kr nocp MP2 interaction energy, freeze_core 0  ")  #TEST
compare([0, 0, 0], nfrzc, "Kr2, Kr, Kr frozen orbitals, freeze_core 0  ")             #TEST

set freeze_core 1
E, nfrzc = nocp_ie()
compare_values(ref_1, E, tol, "Kr--Kr nocp MP2 interaction energy, freeze_core 1  ")  #TEST
compare([18, 9, 9], nfrzc, "Kr2, Kr, Kr frozen orbitals, freeze_core 1  ")            #TEST

set freeze_core -1
E, nfrzc = nocp_ie()
compare_values(ref_1, E, tol, "Kr--Kr nocp MP2 interaction energy, freeze_core -1 ")  #TEST
compare([18, 9, 9], nfrzc, "Kr2, Kr, Kr frozen orbitals, freeze_core -1 ")            #TEST

set freeze_core -2
E, nfrzc = nocp_ie()
compare_values(ref_2, E, tol, "Kr--Kr nocp MP2 interaction energy, freeze_core -2 ")  #TEST
compare([10, 5, 5], nfrzc, "Kr2, Kr, Kr frozen orbitals, freeze_core -2 ")            #TEST

set freeze_core -3
E, nfrzc = nocp_ie()
compare_values(ref_3, E, tol, "Kr--Kr nocp MP2 interaction energy, freeze_core -3 ")  #TEST
compare([2, 1, 1], nfrzc, "Kr2, Kr, Kr frozen orbitals, freeze_core -3 ")             #TEST
