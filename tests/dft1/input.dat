#! DFT Functional Test
#! all values update for new BraggSlater radii

# This input doubles as the cuEST GPU regression: test_input.py reruns it with
# _PSI4_USE_CUEST set.  The cuEST leg differs in three ways, all forced by the
# interface rather than chosen, so it carries its own reference values:
#
#   * cuESTJK is density-fitted only (jk.cc builds it for MEM_DF/DISK_DF), so
#     SCF_TYPE must be DF here rather than the DIRECT used below.
#   * cuEST reproduces regular Psi4 to ~1e-9 only under Stratmann nuclear
#     partitioning.  With the default scheme the meta-GGA drifts to ~5e-5,
#     which is far outside the 7-decimal comparison used throughout.
#   * range-separated functionals are skipped.  cuESTJK::compute_JK() computes
#     J and K but never wK, and nothing checks do_wK_, so a long-range-corrected
#     functional silently converges 1-2 Eh off rather than failing.  Restore
#     wB97/wB97X here once cuEST grows wK support.

cuest = os.environ.get("_PSI4_USE_CUEST", False)

functionals = ["svwn", "b3lyp", "wB97", "wB97X", "b86bpbe", "pw86pbe", "m05", "spw92"]
if cuest:
    functionals = [f for f in functionals if f not in ("wB97", "wB97X")]

# Reference energies, keyed (block number, functional).  Both sets are from
# regular (non-cuEST) Psi4: the first with SCF_TYPE DIRECT, the second with the
# DF/Stratmann setup the cuEST leg requires.
if cuest:
    refs = {                                                                    #TEST
        (1, "svwn"):    -74.9361457674, (1, "b3lyp"):   -75.3200834739,         #TEST
        (1, "b86bpbe"): -75.2981206541, (1, "pw86pbe"): -75.3503184102,         #TEST
        (1, "m05"):     -75.3214214214, (1, "spw92"):   -74.7371639178,         #TEST
        (2, "svwn"):    -74.9361457674, (2, "b3lyp"):   -75.3200834739,         #TEST
        (2, "b86bpbe"): -75.2981206541, (2, "pw86pbe"): -75.3503184102,         #TEST
        (2, "m05"):     -75.3214214214, (2, "spw92"):   -74.7371639178,         #TEST
        (3, "svwn"):    -74.5658273814, (3, "b3lyp"):   -74.9678744373,         #TEST
        (3, "b86bpbe"): -74.9477314548, (3, "pw86pbe"): -74.9997520073,         #TEST
        (3, "m05"):     -74.9703623086, (3, "spw92"):   -74.3874998062,         #TEST
        (4, "svwn"):    -74.4319601928, (4, "b3lyp"):   -74.8158925335,         #TEST
        (4, "b86bpbe"): -74.7908482778, (4, "pw86pbe"): -74.8450791750,         #TEST
        (4, "m05"):     -74.8016980089, (4, "spw92"):   -74.2143762266,         #TEST
    }                                                                           #TEST
else:
    refs = {                                                                    #TEST
        (1, "svwn"):    -74.93570606347603, (1, "b3lyp"):   -75.31971360008332, #TEST
        (1, "wB97"):    -75.31853611933933, (1, "wB97X"):   -75.31282274643111, #TEST
        (1, "b86bpbe"): -75.29768003935945, (1, "pw86pbe"): -75.34987955338264, #TEST
        (1, "m05"):     -75.32103345264673, (1, "spw92"):   -74.736724053,      #TEST
        (2, "svwn"):    -74.93570606347605, (2, "b3lyp"):   -75.3197136000833,  #TEST
        (2, "wB97"):    -75.31853611933931, (2, "wB97X"):   -75.31282274643114, #TEST
        (2, "b86bpbe"): -75.29768003935943, (2, "pw86pbe"): -75.34987955338258, #TEST
        (2, "m05"):     -75.32103345264672, (2, "spw92"):   -74.736724053,      #TEST
        (3, "svwn"):    -74.56540667586837, (3, "b3lyp"):   -74.96751877141122, #TEST
        (3, "wB97"):    -74.97093141849327, (3, "wB97X"):   -74.96327627707228, #TEST
        (3, "b86bpbe"): -74.94731071406106, (3, "pw86pbe"): -74.99933219020076, #TEST
        (3, "m05"):     -74.97000549873393, (3, "spw92"):   -74.387079031,      #TEST
        (4, "svwn"):    -74.43141959776361, (4, "b3lyp"):   -74.81544253378009, #TEST
        (4, "wB97"):    -74.80110016231545, (4, "wB97X"):   -74.79778372673233, #TEST
        (4, "b86bpbe"): -74.79030500240235, (4, "pw86pbe"): -74.84453707167198, #TEST
        (4, "m05"):     -74.80126203682434, (4, "spw92"):   -74.213835345,      #TEST
    }                                                                           #TEST

molecule h2o {
0 1
O 0.000000000000  0.000000000000 -0.068516219310
H 0.000000000000 -0.790689573744  0.543701060724
H 0.000000000000  0.790689573744  0.543701060724
no_com
no_reorient
}

molecule h2op {
1 2
O
H 1 1.0
H 1 1.0 2 104.5
}

molecule h2om {
-1 2
O
H 1 1.0
H 1 1.0 2 104.5
}

set {
    print 2
    basis sto-3g
    dft_spherical_points 302
    dft_radial_points 99
    reference rks
    e_convergence 1.e-8
    d_convergence 1.e-8
}

if cuest:
    psi4.set_options({
        "use_cuest": True,
        "scf_type": "df",
        "df_basis_scf": "def2-universal-JKFIT",
        "dft_nuclear_scheme": "stratmann",
    })
else:
    psi4.set_options({"scf_type": "direct"})

# (block, label, molecule, reference, guess)
blocks = [
    (1, "RKS  0 1", h2o,  "rks", None),
    (2, "UKS  0 1", h2o,  "uks", None),
    (3, "UKS  1 2", h2op, "uks", None),
    (4, "UKS -1 2", h2om, "uks", "sad"),
]

for block, label, mol, reference, guess in blocks:
    psi4.set_options({"reference": reference})
    if guess:
        psi4.set_options({"guess": guess})

    for func in functionals:
        val = energy('scf', dft_functional=func, molecule=mol)
        compare_values(refs[(block, func)], val, 7, f"{label} {func.upper():>7} Energy")  #TEST
