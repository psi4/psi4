#! RHF singlet (RHF->RHF) instability following without symmetry on a slightly rhombic H4 ring in
#! cc-pVDZ. The symmetric guess converges to a D2h-symmetric RHF solution that is a saddle point
#! of the RHF energy: a CHECK run reports its negative totally symmetric singlet eigenvalue, and a
#! FOLLOW run relaxes to the lower symmetry-broken solution and confirms that it is singlet-stable.

molecule h4 {
0 1
H   1.00   0.00  0.00
H   0.00   1.05  0.00
H  -1.00   0.00  0.00
H   0.00  -1.05  0.00
symmetry c1
}

set {
basis cc-pvdz
reference rhf
scf_type pk
d_convergence 8
e_convergence 10
stability_analysis check
}

nucenergy       =   1.9763769551  #TEST
e_saddle_ref    =  -1.8949156257  #TEST
e_relaxed_ref   =  -1.9223210113  #TEST
eig_saddle_ref  =  -0.063390      #TEST
eig_relaxed_ref =   0.070846      #TEST

# Stage 1: CHECK only. The SCF lands on the symmetric saddle point and reports the instability.
e_saddle, wfn = energy('scf', return_wfn=True)
stab = variable("SCF STABILITY EIGENVALUES")

compare_values(nucenergy, h4.nuclear_repulsion_energy(), 9, "Nuclear repulsion energy")                   #TEST
compare_values(e_saddle_ref, e_saddle, 7, "RHF energy of the symmetric (saddle point) solution")           #TEST
compare_values(eig_saddle_ref, stab.get(0, 0, 0), 4, "Lowest singlet Hessian eigenvalue is negative")      #TEST
compare_integers(1, wfn.attempt_number_, "CHECK does not re-run the SCF")                                  #TEST

clean()

# Stage 2: FOLLOW. The orbitals are rotated along the unstable eigenvector and the SCF is re-run.
set stability_analysis follow
e_relaxed, wfn = energy('scf', return_wfn=True)
stab = variable("SCF STABILITY EIGENVALUES")

compare_values(e_relaxed_ref, e_relaxed, 7, "RHF energy after following the instability")                  #TEST
compare_integers(2, wfn.attempt_number_, "FOLLOW re-ran the SCF exactly once")                              #TEST
compare_values(eig_relaxed_ref, stab.get(0, 0, 0), 4, "Relaxed solution is singlet-stable")                 #TEST
compare_integers(1, int(e_relaxed < e_saddle - 0.02), "FOLLOW lowered the energy")                          #TEST
