#! Water/cc-pVDZ, RKS CAM-B3LYP (range-separated hybrid with x_alpha + x_beta != 1): the long-range
#! exact exchange in the response kernel must be scaled by the functional's x_beta, as in the SCF.
#! Static alpha is checked against Psi4's built-in CPKS solver; alpha(omega = 0.1 au) against an
#! independent reference (TDDFT response code on PySCF 2.14, grid level 6; agreement ~3e-8 relative).

molecule {
O  0.00000   0.00000   0.11572
H  0.00000   0.74879  -0.46288
H  0.00000  -0.74879  -0.46288
nocom
no_reorient
symmetry c1
}

set {
  basis cc-pvdz
  scf_type pk
  reference rks
  dft_radial_points 99
  dft_spherical_points 590
  e_convergence 1e-10
  d_convergence 1e-10
  solver_convergence 1e-10
}

XYZ = "XYZ"

# static polarizability: built-in CPKS solver vs the scfresponse module
properties('cam-b3lyp', properties=['DIPOLE_POLARIZABILITIES'])
builtin = {p + q: variable(f"DIPOLE POLARIZABILITY {p}{q}") for p in XYZ for q in XYZ}
set omega [0.0]
properties('cam-b3lyp', properties=['DIPOLE_POLARIZABILITIES'])
for i, p in enumerate(XYZ):
    for q in XYZ[i:]:
        compare_values(builtin[p + q], variable(f"ALPHA({p}{q})"), 1.e-8, f"static alpha {p}{q} vs built-in CPKS")  #TEST

# frequency-dependent polarizability vs an independent reference
ref_alpha = {'XX': 3.315434328379144, 'XY': -3.909678404039402e-15, 'XZ': -1.6703974968154878e-15, 'YY': 7.135440077862648, 'YZ': -3.9073936158961246e-15, 'ZZ': 5.388574572102372}  #TEST
set omega [0.1]
properties('cam-b3lyp', properties=['DIPOLE_POLARIZABILITIES'])
for pq, value in ref_alpha.items():  #TEST
    compare_values(value, variable(f"ALPHA({pq})"), 1.e-6, f"alpha(0.1) {pq} vs reference")  #TEST
