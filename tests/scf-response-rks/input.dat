#! RKS-PBE/cc-pVDZ water at omega = 0.15 au: dipole polarizability
#! for SCF_TYPE PK, DF, and CD. Ported from the scf_response plugin's own tests
#! (edeprince3/scf_response, tests/rks_{pk,df,cd}.in); reference values are the plugin's.
#! The plugin's DFT reference values were generated with the default (1e-6) convergence,
#! so they are compared to 1e-6 here while the calculation itself is converged tightly.

molecule {
O  0.00000   0.00000   0.11572
H  0.00000   0.74879  -0.46288
H  0.00000  -0.74879  -0.46288
nocom
no_reorient
symmetry c1
}

set {
  basis cc-pvdz
  reference rks
  e_convergence 1e-10
  d_convergence 1e-10
  solver_convergence 1e-10
  cholesky_tolerance 1e-12
  omega [0.15]
}

import numpy as np

XYZ = "XYZ"


def wavelength_label(omega):
    """Wavelength label used in the result names: nearest nm, or INF NM for a static field."""
    if abs(omega) < 1.e-14:
        return "INF NM"
    c = psi4.constants
    return f"{round(c.c * c.h * 1.e9 / (c.hartree2J * abs(omega)))}NM"


def alpha_tensor(omega):
    """SCF dipole polarizability tensor (3 x 3) at frequency omega (au)."""
    return np.asarray(variable(f"SCF DIPOLE POLARIZABILITY TENSOR @ {wavelength_label(omega)}"))


def beta_tensor(kind, omega=0.0):
    """SCF first hyperpolarizability tensor (3 x 3 x 3): kind STATIC, SHG, OR, or POCKELS."""
    names = {"STATIC": "SCF DIPOLE HYPERPOLARIZABILITY TENSOR",
             "SHG": "SCF SHG HYPERPOLARIZABILITY TENSOR",
             "OR": "SCF OPTICAL RECTIFICATION HYPERPOLARIZABILITY TENSOR",
             "POCKELS": "SCF POCKELS HYPERPOLARIZABILITY TENSOR"}
    name = names[kind] if kind == "STATIC" else f"{names[kind]} @ {wavelength_label(omega)}"
    return np.asarray(variable(name))


def element(label, kind, omega):
    """Tensor element named like ALPHA(XY) or BETA(XXZ) in the plugin's original tests."""
    idx = tuple(XYZ.index(c) for c in label[label.index('(') + 1:-1])
    return (alpha_tensor(omega) if label.startswith('ALPHA') else beta_tensor(kind, omega))[idx]


ref_vals = {  #TEST
    'pk': {  #TEST
        'POLARIZABILITY': {'ALPHA(XX)': 3.74173021928, 'ALPHA(XY)': -0.0, 'ALPHA(XZ)': -0.0, 'ALPHA(YY)': 7.520054653505, 'ALPHA(YZ)': 0.0, 'ALPHA(ZZ)': 5.886831735888},  #TEST
    },  #TEST
    'df': {  #TEST
        'POLARIZABILITY': {'ALPHA(XX)': 3.741968752207, 'ALPHA(XY)': 0.0, 'ALPHA(XZ)': -0.0, 'ALPHA(YY)': 7.519914828766, 'ALPHA(YZ)': -2e-12, 'ALPHA(ZZ)': 5.887024898072},  #TEST
    },  #TEST
    'cd': {  #TEST
        'POLARIZABILITY': {'ALPHA(XX)': 3.74173021928, 'ALPHA(XY)': -0.0, 'ALPHA(XZ)': -0.0, 'ALPHA(YY)': 7.520054653505, 'ALPHA(YZ)': 0.0, 'ALPHA(ZZ)': 5.886831735888},  #TEST
    },  #TEST
}  #TEST

for scf_type in ['pk', 'df', 'cd']:
    set_options({'scf_type': scf_type})

    properties('pbe', properties=['DIPOLE_POLARIZABILITIES'])
    for label, value in ref_vals[scf_type]['POLARIZABILITY'].items():  #TEST
        compare_values(value, element(label, 'POLARIZABILITY', 0.15), 1e-06, f'{scf_type} {label}')  #TEST
