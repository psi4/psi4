#! regression test of DLPNO-CCSDT, DLPNO-CCSDT(Q), DLPNO-CCSDTQ

ref_scf                   =    -76.0267872755965             #TEST

ref_dlpnoccsdt_corl       =     -0.214499682682              #TEST
ref_dlpnoccsdt_tot        =    -76.241286958276              #TEST
ref_dlpnoccsdt_q_corl     =     -0.214981281550              #TEST
ref_dlpnoccsdt_q_tot      =    -76.241768557100              #TEST
ref_dlpnoccsdtq_tot       =    -76.241742918936              #TEST
ref_dlpnoccsdtq_corl      =     -0.214955643341              #TEST

memory 2 GB

molecule h2o {
0 1
O
H 1 0.957
H 1 0.957 2 104.5
symmetry c1
}

set basis cc-pvdz
set freeze_core True
set scf_type df
set mp2_type df
set cc_type  df
set nat_orbs False
set e_convergence 1.0e-8
set r_convergence 1.0e-8
set pno_convergence very_tight
set write_quadruples_intermediates false

# Algorithm 5 is a Jacobi iteration.  Exercise the immutable old/new T4
# generations in both storage modes and with different OpenMP schedules before
# the full CCSDTQ regression.  The two answers must be storage- and
# thread-count independent.
print('   Testing in-core/disk DLPNO-CCSDT(Q) Jacobi equivalence ...')
set_num_threads(1)
val_q_incore = energy('dlpno-ccsdt(q)')
compare_values(ref_dlpnoccsdt_corl, variable('CCSDT CORRELATION ENERGY'), 6,
               'standalone ccsdt corl before (q)')  #TEST
compare_values(ref_dlpnoccsdt_tot, variable('CCSDT TOTAL ENERGY'), 6,
               'standalone ccsdt total before (q)')  #TEST
compare_values(ref_dlpnoccsdt_q_tot, val_q_incore, 6,
               'in-core standalone ccsdt(q) total')  #TEST
clean()

set_options({'WRITE_QUADRUPLES_INTERMEDIATES': True})
set_num_threads(2)
val_q_disk = energy('dlpno-ccsdt(q)')
compare_values(val_q_incore, val_q_disk, 8, 'ccsdt(q) Jacobi storage/thread equivalence')  #TEST
clean()

print('   Testing DLPNO-CCSDT, DLPNO-CCSDT(Q), and DLPNO-CCSDTQ ...')
set_num_threads(4)
val = energy('dlpno-ccsdtq')

compare_values(ref_scf, variable('SCF TOTAL ENERGY'), 7, 'scf ref')                                 #TEST
compare_values(ref_dlpnoccsdt_corl, variable('CCSDT CORRELATION ENERGY'), 6, 'ccsdt corl')          #TEST
compare_values(ref_dlpnoccsdt_tot, variable('CCSDT TOTAL ENERGY'), 6, 'ccsdt tot')                  #TEST
compare_values(ref_dlpnoccsdt_q_corl, variable('CCSDT(Q) CORRELATION ENERGY'), 6, 'ccsdt(q) corl')  #TEST
compare_values(ref_dlpnoccsdt_q_tot, variable('CCSDT(Q) TOTAL ENERGY'), 6, 'ccsdt(q) tot')          #TEST
compare_values(ref_scf, variable('CURRENT REFERENCE ENERGY'), 6, 'scf ref')                         #TEST
compare_values(ref_dlpnoccsdtq_corl, variable('CURRENT CORRELATION ENERGY'), 6, 'ccsdtq corl')   #TEST
compare_values(ref_dlpnoccsdtq_tot, variable('CURRENT ENERGY'), 6, 'ccsdtq tot')                 #TEST
compare_values(ref_dlpnoccsdtq_corl, variable('CCSDTQ CORRELATION ENERGY'), 6, 'ccsdtq corl')   #TEST
compare_values(ref_dlpnoccsdtq_tot, variable('CCSDTQ TOTAL ENERGY'), 6, 'ccsdtq tot')                 #TEST
compare_values(ref_dlpnoccsdtq_tot - ref_dlpnoccsdt_tot,
               variable('CCSDTQ - CCSDT ENERGY'), 6, 'ccsdtq - ccsdt')                    #TEST
compare_values(ref_dlpnoccsdtq_tot - ref_dlpnoccsdt_q_tot,
               variable('CCSDTQ - CCSDT(Q) ENERGY'), 6, 'ccsdtq - ccsdt(q)')             #TEST
compare_values(ref_dlpnoccsdtq_tot, val, 6, 'ccsdtq return')                                     #TEST
clean()
