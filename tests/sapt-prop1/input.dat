#! SAPT0/cc-pVDZ interaction-induced dipole and quadrupole of the water dimer, with the default
#! properties(): the monomer values and the first-order polarization and exchange terms, which
#! agree with propSAPT v0.5.0.

ref = {  #TEST
    "SAPT MONOMER A DIPOLE": [0.361101834234, 0.0, -0.691226841679],  #TEST
    "SAPT MONOMER B DIPOLE": [0.461131467552, 0.0, 0.693828272399],  #TEST
    "SAPT POL10,R DIPOLE": [0.145501491124, 0.0, 0.03237954555],  #TEST
    "SAPT POL10,R DIPOLE - A": [0.046473635998, 0.0, -0.002511434101],  #TEST
    "SAPT POL10,R DIPOLE - B": [0.099027855126, 0.0, 0.03489097965],  #TEST
    "SAPT EXCH10(S^2) DIPOLE": [-0.018598539975, 0.0, -0.007752444805],  #TEST
    "SAPT EXCH10(S^2) DIPOLE - A": [0.084105992554, 0.0, 0.002138598352],  #TEST
    "SAPT EXCH10(S^2) DIPOLE - B": [-0.102704532529, 0.0, -0.009891043156],  #TEST
    "SAPT EXCH10 DIPOLE": [-0.01888927413, 0.0, -0.007892950918],  #TEST
    "SAPT EXCH10 DIPOLE - A": [0.085283275831, 0.0, 0.002162885793],  #TEST
    "SAPT EXCH10 DIPOLE - B": [-0.104172549961, 0.0, -0.010055836711],  #TEST
    "SAPT MONOMER A QUADRUPOLE": [[-5.304636352849, -0.0, 2.404583332037], [-0.0, -5.210125142648, -0.0], [2.404583332037, -0.0, -3.742661612058]],  #TEST
    "SAPT MONOMER B QUADRUPOLE": [[-2.62063087461, 1e-12, 2.364519614273], [1e-12, -3.052710439991, 0.0], [2.364519614273, 0.0, -4.385126436049]],  #TEST
    "SAPT POL10,R QUADRUPOLE": [[0.129115332096, 0.0, 0.089967999271], [0.0, 0.049411678925, 0.0], [0.089967999271, 0.0, 0.006266749922]],  #TEST
    "SAPT POL10,R QUADRUPOLE - A": [[-0.240200645037, -0.0, -0.01672646924], [-0.0, -0.016416176415, 0.0], [-0.01672646924, 0.0, -0.026804832255]],  #TEST
    "SAPT POL10,R QUADRUPOLE - B": [[0.369315977132, 0.0, 0.10669446851], [0.0, 0.065827855339, 0.0], [0.10669446851, 0.0, 0.033071582177]],  #TEST
    "SAPT EXCH10(S^2) QUADRUPOLE": [[-0.422160542054, 0.0, -0.038163276851], [0.0, -0.002399619666, 0.0], [-0.038163276851, 0.0, -0.004054444203]],  #TEST
    "SAPT EXCH10(S^2) QUADRUPOLE - A": [[-0.170987066233, -0.0, -0.015420178592], [-0.0, 0.004462670231, 0.0], [-0.015420178592, 0.0, -0.004991540774]],  #TEST
    "SAPT EXCH10(S^2) QUADRUPOLE - B": [[-0.251173475821, 0.0, -0.022743098259], [0.0, -0.006862289897, 0.0], [-0.022743098259, 0.0, 0.00093709657]],  #TEST
    "SAPT EXCH10 QUADRUPOLE": [[-0.428848905323, 0.0, -0.03877520255], [0.0, -0.002509568226, 0.0], [-0.03877520255, 0.0, -0.004146370282]],  #TEST
    "SAPT EXCH10 QUADRUPOLE - A": [[-0.173770339572, -0.0, -0.015657079233], [-0.0, 0.004494446014, 0.0], [-0.015657079233, 0.0, -0.005080277867]],  #TEST
    "SAPT EXCH10 QUADRUPOLE - B": [[-0.255078565751, 0.0, -0.023118123317], [0.0, -0.00700401424, 0.0], [-0.023118123317, 0.0, 0.000933907585]],  #TEST
}  #TEST
ref_energy = -0.005639905743  #TEST

molecule dimer {
0 1
O   -1.41606479    0.00000000    0.00000000
H   -0.52004811    0.00000000   -0.08624091
H   -1.81884655    0.00000000   -0.89989100
--
0 1
O    1.41606479    0.00000000    0.00000000
H    1.71179607   -0.76501221    0.50083629
H    1.71179607    0.76501221    0.50083629
symmetry c1
no_com
no_reorient
}

set {
    basis cc-pvdz
    e_convergence 1e-10
    d_convergence 1e-11
}

e, wfn = properties('sapt0', return_wfn=True)

for key, value in ref.items():  #TEST
    compare_values(value, variable(key), 8, key)  #TEST
compare_values(ref_energy, e, 8, "SAPT0 interaction energy")  #TEST
