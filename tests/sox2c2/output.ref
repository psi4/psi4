#! Test of SOX2C-1e with Hydrogen Iodide. Reference is from ReSpect (hf-1eX2C + ucc-pvdz).
#! Uses non-axial symmetry so that Hx, Hy, and Hz components are all non-zero.

ref_e = -7114.458905465102

molecule hydrogen_iodide {
0 1
    I 0 0 0
    H 0.26726 0.53452 0.80178
symmetry C1
}

basis HI_custom_basis {
[dyall-2z]
spherical
