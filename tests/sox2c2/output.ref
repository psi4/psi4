assign I dyall-2z
assign H cc-pvdz-decon
}

set {
  reference cghf
  scf_type direct
  df_scf_guess false
  basis HI_custom_basis
  basis_relativistic HI_custom_basis
  relativistic x2c
  spin_orbit_coupling true
  e_convergence 8
}

try:
    computed_e = energy('scf')
    converged = True
except SCFConvergenceError:
    converged = False

compare(True, converged, "SCF should converge without")          #TEST
compare_values(ref_e, computed_e, 5e-7, "SOX2C-1e total energy") #TEST

