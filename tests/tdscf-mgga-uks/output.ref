#! TDA and RPA excitation energies of triplet methylene with LDA, GGA, and
#! meta-GGA functionals (UKS). The meta-GGA cases exercise the spin-resolved
#! tau second-derivative kernel; the LDA (SVWN = LDA_X + LDA_C_VWN_RPA) and
#! GGA (PBE) cases are rung controls that must reproduce PySCF at those rungs
#! too. RPA is covered as well as TDA because the two contract the generated
#! kernel differently: TDA needs only A, whereas RPA also needs B.
#! The geometry is the experimental triplet structure (H-C-H 134 deg). A
#! near-linear methylene is NOT usable here: as the molecule straightens the
#! two pi orbitals become degenerate, the RPA eigenproblem is ill-conditioned,
#! and the solver fails to converge -- TDA, which drops B and stays Hermitian,
#! does not notice.
#! Reference values from PySCF 2.13.0 (same Libxc): 6-31G, identical geometry,
#! grids.atom_grid = (99, 590) with pruning DISABLED on both sides -- Psi4
#! prunes by default, and an unpruned PySCF reference then integrates on a
#! different grid, which a grid-sensitive meta-GGA notices even though LDA
#! and GGA do not. SCF conv_tol 1e-12, TD conv_tol 1e-9.

svwn_scf = -38.8851687131                                    #TEST
svwn_tda = [0.26503498, 0.27619818, 0.28644599]              #TEST
svwn_rpa = [0.26427501, 0.27493212, 0.28624123]              #TEST
pbe_scf = -39.0795825574                                     #TEST
pbe_tda = [0.27804505, 0.27972238, 0.30226090]               #TEST
pbe_rpa = [0.27655331, 0.27850063, 0.30168899]               #TEST
tpss_scf = -39.1554584424                                    #TEST
tpss_tda = [0.28807213, 0.29502681, 0.31972868]              #TEST
tpss_rpa = [0.28652592, 0.29306435, 0.31814954]              #TEST
r2scan_scf = -39.1204362722                                  #TEST
r2scan_tda = [0.30934376, 0.31476051, 0.33315259]            #TEST
r2scan_rpa = [0.30669578, 0.31235956, 0.33155863]            #TEST

molecule ch2 {
0 3
C  0.000  0.000  0.000
H  0.000  0.9914 -0.4208
H  0.000 -0.9914 -0.4208
symmetry c1
noreorient
}

set {
    reference uks
    basis 6-31G
    scf_type pk
    save_jk true
    dft_spherical_points 590
    dft_radial_points 99
    dft_pruning_scheme flat
    e_convergence 10
    d_convergence 9
}

from psi4.driver.procrouting.response.scf_response import tdscf_excitations

for func, ref_scf, ref_tda, ref_rpa in (
        ("SVWN", svwn_scf, svwn_tda, svwn_rpa),
        ("PBE", pbe_scf, pbe_tda, pbe_rpa),
        ("TPSS", tpss_scf, tpss_tda, tpss_rpa),
        ("R2SCAN", r2scan_scf, r2scan_tda, r2scan_rpa)):
    e, wfn = energy(func, return_wfn=True)
    compare_values(ref_scf, e, 5, f"{func} SCF energy vs PySCF")              #TEST
    for tda, ref_exc in ((True, ref_tda), (False, ref_rpa)):
        kind = "TDA" if tda else "RPA"
        res = tdscf_excitations(wfn, states=5, tda=tda, r_convergence=1e-7)
        for i, ref in enumerate(sorted(ref_exc)):                              #TEST                              #TEST
            compare_values(ref,                                                #TEST
                           sorted(r["EXCITATION ENERGY"] for r in res)[i], 4,  #TEST
                           f"{func} {kind} root {i+1} vs PySCF")               #TEST
    clean()
