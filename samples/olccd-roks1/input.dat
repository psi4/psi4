#! OLCCD cc-pCVDZ energy with ROKS-B3LYP initial guess for the NO radical

# OLCCD energy matches the ROHF reference; orbital optimization removes the dependence on the DFT guess
# Reference: olccd3 test (ROHF)

molecule no {
0 2
n
o 1 1.158
}

set {
  basis cc-pcvdz
  reference roks
  guess gwh
}

energy('olccd', dft_functional='b3lyp')

