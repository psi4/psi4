#! OMP2.5 cc-pVDZ energy with ROKS-B3LYP initial guess for the NO radical

# OMP2.5 energy matches the ROHF reference; orbital optimization removes the dependence on the DFT guess
# Reference: omp2p5-2 test (ROHF)

molecule {
0 2
n
o 1 1.158
}

set {
  basis cc-pvdz
  guess gwh
  reference roks
}

energy('omp2.5', dft_functional='b3lyp')

