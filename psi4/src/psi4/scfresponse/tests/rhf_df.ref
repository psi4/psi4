# 
# frequency-dependent polarizability and hyperpolarizability (SHG, OR, POCKELS)
# UHF / cc-pVDZ / DF
#

sys.path.insert(0, './../..')
import scf_response

molecule {
O  0.00000   0.00000   0.11572
H  0.00000   0.74879  -0.46288
H  0.00000  -0.74879  -0.46288
nocom
no_reorient
symmetry c1
}

set {
  scf_type df
  basis cc-pvdz
  omega [0.15]
  reference rhf
  e_convergence 1e-10
  d_convergence 1e-10
}

en, wfn = energy('scf', return_wfn = True)

set {
    property 'POLARIZABILITY'
}
energy('scf_response', ref_wfn = wfn)

print('')
print('    ==> POLARIZABILITY <==')
print('')
compare_values(  3.253823917921, psi4.variable("ALPHA(XX)"), 8, "ALPHA(XX)")
compare_values(  0.000000000000, psi4.variable("ALPHA(XY)"), 8, "ALPHA(XY)")
compare_values( -0.000000000000, psi4.variable("ALPHA(XZ)"), 8, "ALPHA(XZ)")
compare_values(  7.038845240481, psi4.variable("ALPHA(YY)"), 8, "ALPHA(YY)")
compare_values( -0.000000000001, psi4.variable("ALPHA(YZ)"), 8, "ALPHA(YZ)")
compare_values(  5.260454069225, psi4.variable("ALPHA(ZZ)"), 8, "ALPHA(ZZ)")

set {
